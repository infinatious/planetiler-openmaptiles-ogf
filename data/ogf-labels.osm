<?xml version="1.0" encoding="UTF-8"?>
<osm version="0.6" generator="ogf-planetiler-continent-ocean-labels">
  <!-- Continent and ocean label points, ported 1:1 from ogfsql.sql's
       "Add OGF Continents" / "Add OGF Oceans" INSERT statements, including the
       same osm_id block (99990000001-99990000014) they used - Planetiler
       rejects negative OSM element IDs, unlike raw imposm3/PostGIS. Merged into
       the OGF planet PBF before each Planetiler run since there is no
       post-import SQL step in this pipeline. -->
  <node id="99990000001" lat="-39.02" lon="147.31" version="1">
    <tag k="place" v="continent"/>
    <tag k="name" v="South Archanta"/>
  </node>
